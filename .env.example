# Ethernals settings. Copy this file to .env (never commit .env) and fill in the blanks.
# SETUP.md explains where every value comes from, step by step.

# --- App -------------------------------------------------------------------
APP_NAME=Ethernals
# The public address of the app (your tunnel or host). Run `pnpm ens:sync` after changing it.
PUBLIC_BASE_URL=http://localhost:3000
# Demo controls (expire/restore pass). Turn off for a real deployment.
DEMO_MODE=true
# Local development only: people without World ID. MUST be false for the demo.
DEV_FAKE_PERSONS=false

# --- Secrets (fill with: pnpm doctor --gen-secrets) -------------------------
SESSION_SECRET=
PERSON_HASH_SECRET=
KEYSTORE_SECRET=
ADMIN_TOKEN=
DATABASE_PATH=./data/ethernals.db

# --- AI model (console.anthropic.com) ---------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# --- World ID (developer.world.org) -----------------------------------------
WORLD_APP_ID=
WORLD_RP_ID=
# Shown only once when you create the app. Keep it secret.
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=ethernals-signup
# staging = World ID Simulator (fake people); production = real World App
WORLD_ENV=staging
# Set to true only if the Simulator cannot produce World ID 4.0 proofs.
WORLD_ALLOW_LEGACY_PROOFS=false
# idkit (default) or agentkit (also requires agent wallets registered in World's AgentBook)
HUMAN_MODE=idkit
# agentkit mode only (World Chain RPC for AgentBook lookups)
WORLD_CHAIN_RPC_URL=

# --- Hedera testnet (portal.hedera.com) -------------------------------------
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
# ECDSA "HEX Encoded Private Key" (0x...)
HEDERA_OPERATOR_KEY=
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
# USDC (default) or HBAR (fallback if USDC gives trouble)
PAYMENT_ASSET=USDC
HEDERA_USDC_TOKEN_ID=0.0.429274
# Given to every new person's buyer agent
BUYER_STARTING_USDC=1.00
# Small float for seller agents so they can pay sub-agents
SELLER_STARTING_USDC=0.20
# x402 payment helper. Backup: https://api.testnet.blocky402.com
X402_FACILITATOR_URL=https://x402.org/facilitator
# Written for you by: pnpm deploy:ledger
HIRE_LEDGER_ADDRESS=

# --- Ethereum Sepolia (ENS + Arena) -----------------------------------------
# Your Alchemy/Infura Sepolia URL (used by the server for writes)
SEPOLIA_RPC_URL=
# A brand-new MetaMask test wallet that owns your ENS name
SEPOLIA_PRIVATE_KEY=
# Public RPC the browser uses to read ENS records
PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# The .eth name you registered on Sepolia, e.g. ethernals-team42.eth
ENS_PARENT_NAME=
# Written for you by: pnpm ens:setup
ENS_RESOLVER_ADDRESS=
# Official ERC-8004 registries on Sepolia (used by the Arena's left side)
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713

# --- Arena -------------------------------------------------------------------
ARENA_FAKE_REVIEWERS=20
ARENA_FARM_HIRES=20
# Read-only, to show what the fake reviews would cost on Base mainnet
BASE_MAINNET_RPC_URL=https://mainnet.base.org
ETH_USD_PRICE=3500

# --- Proof-of-work tasks (docs/proof-of-work/PLAN.md) ------------------------
# Escrow + tUSDC live on Ethereum SEPOLIA (Namera's session-key policies run there; Namera does not support Hedera).
# Payments (x402 attempt fees) and the HireLedger stay on Hedera testnet.
# Written for you by: pnpm deploy:escrow
TASK_ESCROW_ADDRESS=
MOCK_USDC_ADDRESS=
# The sandbox verifier (apps/verifier)
VERIFIER_URL=http://127.0.0.1:4100
VERIFIER_PORT=4100
# Public base URL where signed result JSON is served (used as the on-chain resultURI)
VERIFIER_PUBLIC_URL=http://localhost:4100
# Shared secret the server sends as x-verifier-token (pnpm verifier:setup fills it)
VERIFIER_TOKEN=
# Validator key: settles TaskEscrow and answers ERC-8004 validations, both on Sepolia (pnpm verifier:setup fills it)
VERIFIER_PRIVATE_KEY=
# docker (isolated, default) | local (runs tests on this machine, NOT isolated - development only)
VERIFIER_MODE=docker
VERIFIER_IMAGE=ethernals-pytest:latest
VERIFIER_TIMEOUT_SECONDS=120
# Where the verifier keeps uploaded hidden tests, jobs and signed results (git-ignored)
VERIFIER_DATA_DIR=./data/verifier
# Optional: charge specialists a small x402 fee (USDC on Hedera testnet) per verification run
VERIFIER_FEE_USDC=0.02
# Hedera account that receives the verification fee (pnpm verifier:setup creates it)
VERIFIER_HEDERA_PAYTO=
# Official ERC-8004 Validation Registry on Sepolia (testnet deployment)
ERC8004_VALIDATION_REGISTRY=0x8004Cb1BF31DAf7788923b405b754f57acEB4272
# Demo defaults
TASK_DEFAULT_BOUNTY=2.00
# tUSDC minted to each client account for bounties
TASK_CLIENT_STARTING_TUSDC=10

# --- 0G Compute Router: where every agent thinks (docs.0g.ai > Compute > Router) ---
# false = fall back to ANTHROPIC_API_KEY (development only; the demo must run on 0G)
ZG_ENABLED=true
# testnet (pc.testnet.0g.ai, free faucet tokens) or mainnet (pc.0g.ai, real 0G tokens)
ZG_NETWORK=testnet
ZG_ROUTER_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
# Management key (mk-..., scopes keys:create + keys:read): creates one API key per agent. Server-side only.
ZG_MANAGEMENT_KEY=
# Fallback shared API key (sk-...) if per-agent key creation fails
ZG_API_KEY=
# Optional extra sk- keys, comma separated (e.g. a second 0G account). Each agent is assigned one key and keeps it.
ZG_API_KEYS=
# Model id from GET {ZG_ROUTER_BASE_URL}/models. Empty = pick automatically (prefers 0gm-1.0-35b-a3b, built for agentic coding)
ZG_MODEL=
# Brain credit (neuron; 1e18 neuron = 1 0G): given to a new agent, and the minimum needed to accept one task
ZG_SEED_CREDIT_NEURON=300000000000000000
ZG_MIN_CREDIT_NEURON=60000000000000000
# Earnings -> brain credit rate (neuron per 1 USDC earned). Internal accounting, disclosed in the README.
ZG_NEURON_PER_USDC=2000000000000000000

# --- Namera: spending controls for client agents (namera.ai) ---
# Leave empty to use the SDK default API URL.
NAMERA_API_URL=
# Per-person Namera credentials are pasted on /me and stored encrypted; nothing else is needed here.
# Only for Dev A's self-test (packages/spend-guard/scripts/spend-selftest.ts); leave empty otherwise:
NAMERA_TEST_API_KEY=
NAMERA_TEST_WALLET_ID=
NAMERA_TEST_SESSION_KEY_ID=
# false = force the "direct" fallback guard (server-side limits only).
NAMERA_ENABLED=true
