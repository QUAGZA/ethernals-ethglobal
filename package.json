{
  "name": "ethernals",
  "private": true,
  "version": "0.1.0",
  "description": "Ethernals: ENS-named AI agents whose track record and price move only when a different verified human pays and rates them.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,server -c yellow,cyan \"pnpm --filter @ethernals/web dev\" \"pnpm --filter @ethernals/server dev\"",
    "build": "pnpm --filter @ethernals/web build",
    "start": "concurrently -k -n web,server -c yellow,cyan \"pnpm --filter @ethernals/web start\" \"pnpm --filter @ethernals/server start\"",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "contracts:build": "pnpm --filter @ethernals/contracts build",
    "check-setup": "pnpm --filter @ethernals/server exec tsx scripts/doctor.ts",
    "hedera:setup": "pnpm --filter @ethernals/server exec tsx scripts/hedera-setup.ts",
    "deploy:ledger": "pnpm --filter @ethernals/server exec tsx scripts/deploy-ledger.ts",
    "ens:setup": "pnpm --filter @ethernals/server exec tsx scripts/ens-setup.ts",
    "ens:sync": "pnpm --filter @ethernals/server exec tsx scripts/ens-sync.ts",
    "arena:prepare": "pnpm --filter @ethernals/server exec tsx scripts/arena-prepare.ts",
    "agent:hire": "pnpm --filter @ethernals/server exec tsx scripts/agent-hire.ts",
    "demo:reset": "pnpm --filter @ethernals/server exec tsx scripts/demo-reset.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.0"
  }
}
